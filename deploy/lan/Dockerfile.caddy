# The backoffice built for this server, served by Caddy (T-331, ADR-0171). The build context `backoffice` is the
# folder of base-ecomm-admin (BACKOFFICE_DIR in .env.server).
FROM node:22-bookworm-slim AS build
WORKDIR /app
ARG API_BASE_URL
ARG PRIVACY_NOTICE_VERSION=
ENV NUXT_PUBLIC_API_BASE_URL=${API_BASE_URL} \
    NUXT_PUBLIC_PRIVACY_NOTICE_VERSION=${PRIVACY_NOTICE_VERSION} \
    NPM_CONFIG_UPDATE_NOTIFIER=false \
    NPM_CONFIG_FUND=false
COPY --from=backoffice package.json package-lock.json ./
RUN npm ci
# Only what the build needs, never the node_modules or the .env of that folder.
COPY --from=backoffice nuxt.config.ts tsconfig.json .nuxtrc ./
COPY --from=backoffice app ./app
COPY --from=backoffice public ./public
RUN npm run build

FROM caddy:2
COPY Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/.output/public /srv/backoffice
