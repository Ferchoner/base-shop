{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testRegex": ".e2e-spec.ts$",
  "extensionsToTreatAsEsm": [".ts"],
  "moduleNameMapper": {
    "^(\\.{1,2}/.*)\\.js$": "$1"
  },
  "transform": {
    "^.+\\.ts$": [
      "ts-jest",
      {
        "useESM": true,
        "astTransformers": {
          "before": ["<rootDir>/test/swagger-plugin.cjs"]
        }
      }
    ]
  },
  "testEnvironment": "node",
  "globalSetup": "<rootDir>/test/integration/global-setup.ts",
  "globalTeardown": "<rootDir>/test/integration/global-teardown.ts",
  "testTimeout": 30000,
  "setupFiles": ["<rootDir>/test/e2e-environment.ts"],
  "setupFilesAfterEnv": [
    "<rootDir>/test/setup-esm-interop.ts",
    "<rootDir>/test/e2e-manual-payments.ts"
  ],
  "roots": ["<rootDir>/test"],
  "collectCoverageFrom": [
    "src/**/*.ts",
    "!src/**/*.spec.ts",
    "!src/**/*.int-spec.ts",
    "!src/platform/persistence/prisma/generated/**",
    "!src/main.ts",
    "!src/scripts/**"
  ],
  "coverageDirectory": "<rootDir>/coverage/e2e",
  "coverageReporters": ["json"]
}
