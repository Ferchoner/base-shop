// Catalog (DATABASE.md §4).

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@map("product_status")
}

enum VariantStatus {
  ACTIVE
  DISCONTINUED

  @@map("variant_status")
}

model Brand {
  id        String        @id @db.Uuid
  name      String
  slug      String        @unique
  status    CatalogStatus
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  products Product[]

  @@map("brands")
}

model Category {
  id        String        @id @db.Uuid
  parentId  String?       @map("parent_id") @db.Uuid
  name      String
  slug      String        @unique
  status    CatalogStatus
  position  Int           @default(0)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  parent   Category?         @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  children Category[]        @relation("CategoryTree")
  products ProductCategory[]

  @@index([parentId])
  @@map("categories")
}

model Product {
  id               String                   @id @db.Uuid
  title            String
  slug             String                   @unique
  description      String?
  brandId          String?                  @map("brand_id") @db.Uuid
  status           ProductStatus            @default(DRAFT)
  publishedAt      DateTime?                @map("published_at") @db.Timestamptz(3)
  archivedAt       DateTime?                @map("archived_at") @db.Timestamptz(3)
  firstPublishedAt DateTime?                @map("first_published_at") @db.Timestamptz(3)
  /// Title, brand and visible categories; maintained by the application (ADR-0060, ADR-0080).
  searchVector     Unsupported("tsvector")? @map("search_vector")
  version          Int                      @default(1)
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)

  brand      Brand?            @relation(fields: [brandId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  categories ProductCategory[]
  variants   ProductVariant[]
  images     ProductImage[]

  @@index([searchVector], type: Gin)
  @@index([status, publishedAt(sort: Desc)])
  @@index([brandId])
  @@map("products")
}

model ProductCategory {
  productId  String @map("product_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([productId, categoryId])
  @@index([categoryId])
  @@map("product_categories")
}

model ProductVariant {
  id          String        @id @db.Uuid
  productId   String        @map("product_id") @db.Uuid
  sku         String        @unique
  options     Json          @db.JsonB
  status      VariantStatus
  weightGrams Int?          @map("weight_grams")
  lengthCm    Decimal?      @map("length_cm") @db.Decimal(7, 1)
  widthCm     Decimal?      @map("width_cm") @db.Decimal(7, 1)
  heightCm    Decimal?      @map("height_cm") @db.Decimal(7, 1)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  product Product        @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  images  ProductImage[]

  /// Option combinations are unique among active variants only (BR-PRD-02, ADR-0076).
  @@unique([productId, options], map: "product_variants_active_options_key", where: raw("status = 'ACTIVE'::variant_status"))
  @@index([productId])
  @@map("product_variants")
}

model ProductImage {
  id          String   @id @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  variantId   String?  @map("variant_id") @db.Uuid
  /// Relative storage key; the public URL is built when responding (ADR-0024).
  storageKey  String   @unique @map("storage_key")
  contentType String   @map("content_type")
  sizeBytes   Int      @map("size_bytes")
  altText     String?  @map("alt_text")
  position    Int
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull, onUpdate: Restrict)

  @@index([productId, position])
  @@map("product_images")
}
