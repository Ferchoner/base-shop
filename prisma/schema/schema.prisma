// Prisma schema split by bounded context: one file per context plus transversal.prisma (ADR-0066, ADR-0091).
// The connection URL lives in prisma.config.ts. Constraints Prisma cannot express (CHECK, exclusion,
// expression indexes, trigger, extensions, sequence) are added as SQL in the migrations (DATABASE.md §13).
// Rules: no relations or foreign keys between contexts (ADR-0005); IDs are generated by the application.

generator client {
  provider            = "prisma-client"
  output              = "../../src/platform/persistence/prisma/generated"
  moduleFormat        = "esm"
  importFileExtension = "js"
  previewFeatures     = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

/// Status shared by catalog entities, price lists and warehouses (ADR-0038).
enum CatalogStatus {
  ACTIVE
  INACTIVE

  @@map("catalog_status")
}
