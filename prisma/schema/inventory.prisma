// Inventory (DATABASE.md §6).

enum StockMovementType {
  RECEIPT
  ADJUSTMENT
  SALE
  RESTOCK
  /// One side of a transfer between warehouses (ADR-0172): signed, linked to its transfer.
  TRANSFER

  @@map("stock_movement_type")
}

enum StockMovementReason {
  PHYSICAL_COUNT
  DAMAGED
  LOSS_OR_THEFT
  INTERNAL_USE
  DATA_ENTRY_ERROR
  OTHER
  ORDER_CANCELLED
  SHIPMENT_RETURNED
  WAREHOUSE_TRANSFER

  @@map("stock_movement_reason")
}

/// Why stock goes to another warehouse (ADR-0172): to sell it there, to restock it, or another reason with a note.
enum StockTransferReason {
  SALE
  RESTOCK
  OTHER
  /// A loan to show it in the other warehouse (T-164).
  SHOW
  /// What came back from a loan when it was closed (T-164).
  LOAN_RETURN

  @@map("stock_transfer_reason")
}

/// A transfer is done when it is recorded, and cancelled only in its first minutes; a loan is open until it is
/// closed (ADR-0172).
enum StockTransferStatus {
  COMPLETED
  CANCELLED
  OPEN
  CLOSED

  @@map("stock_transfer_status")
}

/// A transfer for good, or a loan to show the units that has a time to come back (ADR-0172).
enum StockTransferKind {
  TRANSFER
  LOAN

  @@map("stock_transfer_kind")
}

enum ReservationStatus {
  ACTIVE
  COMMITTED
  RELEASED
  EXPIRED

  @@map("reservation_status")
}

model Warehouse {
  id        String        @id @db.Uuid
  code      String        @unique
  name      String
  /// Address in the ADR-0057 format.
  address   Json?         @db.JsonB
  status    CatalogStatus
  /// 1 is the first: an order is reserved in the first active warehouse that holds all of it, by priority and then
  /// code (ADR-0160). From 1 to 1000 (CHECK in the migration).
  priority  Int           @default(1)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  stockItems   StockItem[]
  transfersOut StockTransfer[] @relation("transfer_from")
  transfersIn  StockTransfer[] @relation("transfer_to")

  @@map("warehouses")
}

model StockItem {
  id          String   @id @db.Uuid
  /// Logical reference to Catalog; no foreign key (ADR-0005).
  variantId   String   @map("variant_id") @db.Uuid
  warehouseId String   @map("warehouse_id") @db.Uuid
  onHand      Int      @default(0) @map("on_hand")
  reserved    Int      @default(0)
  /// Where it is in its warehouse (ADR-0173): 1 to 20 characters, upper case and trimmed; `null` without one.
  location    String?  @db.VarChar(20)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  warehouse        Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  movements        StockMovement[]
  reservationLines ReservationLine[]

  @@unique([variantId, warehouseId])
  @@index([warehouseId, location])
  @@map("stock_items")
}

model StockMovement {
  id          String               @id @db.Uuid
  stockItemId String               @map("stock_item_id") @db.Uuid
  type        StockMovementType
  /// Signed quantity.
  quantity    Int
  onHandAfter Int                  @map("on_hand_after")
  reasonCode  StockMovementReason? @map("reason_code")
  note        String?
  /// Logical references to Ordering (SALE, RESTOCK).
  orderId     String?              @map("order_id") @db.Uuid
  orderLineId String?              @map("order_line_id") @db.Uuid
  /// The transfer of a TRANSFER movement, and only of one (CHECK in the migration, ADR-0172).
  transferId  String?              @map("transfer_id") @db.Uuid
  actorId     String?              @map("actor_id") @db.Uuid
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  stockItem StockItem      @relation(fields: [stockItemId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  transfer  StockTransfer? @relation(fields: [transferId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([stockItemId, createdAt])
  @@index([transferId])
  @@index([orderLineId], map: "stock_movements_restock_by_order_line_idx", where: raw("type = 'RESTOCK'::stock_movement_type"))
  @@map("stock_movements")
}

model Reservation {
  id        String            @id @db.Uuid
  /// Logical reference to Ordering; no foreign key (ADR-0005).
  orderId   String            @map("order_id") @db.Uuid
  status    ReservationStatus
  expiresAt DateTime          @map("expires_at") @db.Timestamptz(3)
  version   Int               @default(1)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  lines ReservationLine[]

  @@unique([orderId], map: "reservations_one_active_per_order", where: raw("status = 'ACTIVE'::reservation_status"))
  @@map("reservations")
}

model ReservationLine {
  reservationId String @map("reservation_id") @db.Uuid
  stockItemId   String @map("stock_item_id") @db.Uuid
  quantity      Int

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  stockItem   StockItem   @relation(fields: [stockItemId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([reservationId, stockItemId])
  @@map("reservation_lines")
}

/// A file of receipts already imported, so the same file is not imported twice (ADR-0164).
model StockReceiptImport {
  id         String   @id @db.Uuid
  /// SHA-256 of the bytes of the file, in lowercase hexadecimal. CHECK: 64 hexadecimal digits (manual SQL).
  fileSha256 String   @unique @map("file_sha256") @db.Char(64)
  /// CHECK: above 0 (manual SQL).
  rows       Int
  /// CHECK: above 0 (manual SQL).
  units      Int
  /// The staff member who imported it; a logical reference to Identity.
  createdBy  String   @map("created_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("stock_receipt_imports")
}

/// Units moved from one warehouse to another in one step (ADR-0172): each line leaves the origin and enters the
/// destination in the same transaction. Never edited; cancelled only in its first 10 minutes.
model StockTransfer {
  id              String              @id @db.Uuid
  /// Consecutive number from a database sequence, shown as the folio `T-000123`, or `P-000123` for a loan (ADR-0172).
  number          BigInt              @unique @default(autoincrement())
  kind            StockTransferKind   @default(TRANSFER)
  /// CHECK: not the destination (manual SQL).
  fromWarehouseId String              @map("from_warehouse_id") @db.Uuid
  toWarehouseId   String              @map("to_warehouse_id") @db.Uuid
  reason          StockTransferReason
  /// CHECK: 1 to 500 characters, and present with OTHER (manual SQL).
  note            String?
  status          StockTransferStatus
  /// Logical references to Identity: who recorded it and who cancelled it.
  createdBy       String              @map("created_by") @db.Uuid
  createdAt       DateTime            @map("created_at") @db.Timestamptz(3)
  /// CHECK: both present exactly when it is cancelled (manual SQL).
  cancelledBy     String?             @map("cancelled_by") @db.Uuid
  cancelledAt     DateTime?           @map("cancelled_at") @db.Timestamptz(3)
  /// When a loan should come back. CHECK: exactly with LOAN, 5 minutes to 24 hours after it was recorded (manual SQL).
  returnBy        DateTime?           @map("return_by") @db.Timestamptz(3)
  /// Who closed a loan and when. CHECK: both present exactly when it is closed (manual SQL).
  closedBy        String?             @map("closed_by") @db.Uuid
  closedAt        DateTime?           @map("closed_at") @db.Timestamptz(3)
  /// The loan this transfer brought back. CHECK: exactly with LOAN_RETURN (manual SQL).
  loanId          String?             @unique @map("loan_id") @db.Uuid
  version         Int                 @default(1)
  updatedAt       DateTime            @map("updated_at") @db.Timestamptz(3)

  fromWarehouse Warehouse           @relation("transfer_from", fields: [fromWarehouseId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  toWarehouse   Warehouse           @relation("transfer_to", fields: [toWarehouseId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  lines         StockTransferLine[]
  movements     StockMovement[]
  loan          StockTransfer?      @relation("loan_return", fields: [loanId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  returnOf      StockTransfer?      @relation("loan_return")

  @@index([createdAt])
  @@index([kind, status, returnBy])
  @@index([fromWarehouseId, createdAt])
  @@index([toWarehouseId, createdAt])
  @@map("stock_transfers")
}

/// A variant of a transfer and its units, once per transfer.
model StockTransferLine {
  transferId String @map("transfer_id") @db.Uuid
  /// Logical reference to Catalog; no foreign key (ADR-0005).
  variantId  String @map("variant_id") @db.Uuid
  /// CHECK: 1 to 100,000 (manual SQL).
  quantity   Int
  /// The units of a loan line that came back when it was closed. CHECK: 0 to the quantity (manual SQL).
  returned   Int?

  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@id([transferId, variantId])
  @@index([variantId])
  @@map("stock_transfer_lines")
}
