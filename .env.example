# Copy this file to .env and fill in the values. Never commit .env (ADR-0032).
# Every variable the API reads is listed here, with a description and a non-real example value.
# The API validates these variables at startup and does not start if a required one is missing or invalid.

# Runtime environment: development, test or production. Required.
NODE_ENV=development

# HTTP port the API listens on. Optional; defaults to 3000.
PORT=3000

# Origins allowed by CORS (ADR-0085): exact origins (http or https, host and optional port),
# separated by commas, with no path, trailing slash or "*". Optional.
# Empty means no browser on another origin can call the API.
# Example: http://localhost:5173,https://shop.example.com
CORS_ALLOWED_ORIGINS=

# PostgreSQL connection string used by Prisma (ADR-0091). Required.
# This value points to the database published by docker compose on the host; the api container in
# docker compose gets its own DATABASE_URL pointing to the postgres service. Use URL-safe characters
# in POSTGRES_PASSWORD or percent-encode them here.
DATABASE_URL=postgresql://base_shop:change-me-local-only@localhost:5432/base_shop

# Least severe level written to the console (ADR-0097): fatal, error, warn, log, debug or verbose.
# Every more severe level is written too. Optional; defaults to log. With debug, the log also shows
# the messages of domain errors. Logs are text in development and test, and JSON lines in production.
LOG_LEVEL=log

# Whether the scheduler runs the periodic jobs (ADR-0101): true or false. Optional; defaults to true.
# The automated tests set it to false so jobs do not touch their data.
JOBS_ENABLED=true

# Seconds a cached value lives (ADR-0028, ADR-0104): whole number from 1 to 86400. Optional; defaults to 120.
# Only public catalog reads are cached; the cache lives in memory and is lost when the API restarts.
CACHE_TTL_SECONDS=120

# Addresses a customer can keep in their address book (BR-ADR-04, ADR-0113): whole number from 1 to 100.
# Optional; defaults to 10.
MAX_ADDRESSES_PER_CUSTOMER=10

# Rate limits (ADR-0065, ADR-0102), each as <count>/<duration> with the duration in s, m or h.
# All optional; the values below are the defaults. Counters live in memory and reset when the API restarts.
# Requests per IP on every endpoint without a specific limit.
RATE_LIMIT_DEFAULT=100/1m
# Failed logins per email, and per IP.
RATE_LIMIT_LOGIN_EMAIL=5/15m
RATE_LIMIT_LOGIN_IP=20/15m
# Sign-ups per IP.
RATE_LIMIT_REGISTER=5/1h
# Password reset requests per email, and per IP.
RATE_LIMIT_PASSWORD_RESET_EMAIL=3/1h
RATE_LIMIT_PASSWORD_RESET_IP=10/1h
# Verification emails per email or signed-in user (resend verification and change email).
RATE_LIMIT_EMAIL_VERIFICATION=3/1h
# Guest order lookups and reorders per IP.
RATE_LIMIT_GUEST_ORDER=10/15m
# Orders placed per user or cart.
RATE_LIMIT_PLACE_ORDER=10/10m

# Email (ADR-0045, ADR-0110). The defaults send to Mailpit, the local catcher started by docker compose:
# emails never leave the machine and are read at http://localhost:8025. All four are optional in
# development and test, and required in production, where the real provider (P-24) is configured.
# SMTP server host and port (465 uses TLS from the start). The api container in docker compose gets
# SMTP_HOST=mailpit, the service name inside the compose network.
SMTP_HOST=localhost
SMTP_PORT=1025
# Sender of every email: an address, or "Name <address>".
MAIL_FROM=base-shop <no-reply@base-shop.test>
# Base URL of the frontend for links in emails (ADR-0056): http or https, optional path, no query,
# fragment or trailing slash. Example: https://shop.example.com
FRONTEND_BASE_URL=http://localhost:5173

# Sessions (ADR-0023, ADR-0114).
# Key that signs the access tokens (HS256): at least 32 characters, random, and secret. Required in
# production. Leave it empty in development: the API then signs with a random key generated at startup,
# and every session ends when it restarts. Generate one with: openssl rand -base64 32
JWT_SECRET=
# Lifetime of an access token, from 1m to 1h. Optional; defaults to 15m.
ACCESS_TOKEN_TTL=15m
# Lifetime of a refresh token, from 1h to 90d; each renewal issues a new one. Optional; defaults to 7d.
REFRESH_TOKEN_TTL=7d

# First superadmin (UC-IAM-20, ADR-0116). Read only by the script that creates it
# (npm run superadmin:create); the API ignores them. The script generates a temporary password,
# shows it once and asks for a new one on the first sign-in. Once a superadmin exists, create
# staff through the API. Email: an address of at most 254 characters. Names: 1 to 100 characters.
SUPERADMIN_EMAIL=
SUPERADMIN_FIRST_NAMES=
SUPERADMIN_LAST_NAMES=

# --- Local services started by docker compose (T-102) ---
# These are read by docker-compose.yml, not by the API. Example values only: choose your own.

# PostgreSQL 18 credentials and database for local development. Required by docker compose.
POSTGRES_USER=base_shop
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=base_shop

# Host port where PostgreSQL is published. Optional; defaults to 5432.
POSTGRES_PORT=5432
