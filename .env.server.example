# Local network server (T-331, ADR-0171). Copy to .env.server, fill every value marked "change", and keep the file
# only on the server: it holds the passwords. Guide: docs/LAN_SERVER.md.
# docker-compose.server.yml sets the database URL, the URLs of the frontends, the email server and TRUST_PROXY_HOPS
# from these values; any other variable of .env.example can be added here.

# ── Server ──
# The fixed IP of this computer in the store network (or a name every computer resolves), without https://.
SERVER_ADDRESS=192.168.1.50
# The folder of base-ecomm-admin, the backoffice that Caddy builds and serves.
BACKOFFICE_DIR=../base-ecomm-admin
# Version of the privacy notice the staff presents to a guest in the store (ADR-0161). Empty: no guests.
PRIVACY_NOTICE_VERSION=

# ── Database ──
# The owner of the schema, used only by the migrations. Change both passwords: long and random.
POSTGRES_USER=base_shop
POSTGRES_PASSWORD=change-me
POSTGRES_DB=base_shop
# The user of the API, which only reads and writes data. Created the first time the database starts.
APP_DB_USER=base_shop_app
APP_DB_PASSWORD=change-me-too

# ── Backups ──
# Folder of this computer for the daily pg_dump; better on another disk or a synced folder.
BACKUP_DIR=./backups
# Hour of the daily backup, 0 to 23 without a leading zero, Mexico City time.
BACKUP_HOUR=23
BACKUP_KEEP_DAYS=14

# ── API ──
# At least 32 random characters. Change it, and never reuse the one of another environment.
JWT_SECRET=
# The data of the ticket (ADR-0163).
STORE_NAME=Mi tienda de videojuegos
STORE_ADDRESS=
STORE_TAX_ID=
STORE_PHONE=
TICKET_FOOTER=Este ticket no es un comprobante fiscal.
WORK_ORDER_FOOTER=
MAIL_FROM=Mi tienda <no-reply@tienda.local>
VAT_RATE_BP=1600

# The first superadmin, created once with the script of the guide.
SUPERADMIN_EMAIL=
SUPERADMIN_FIRST_NAMES=
SUPERADMIN_LAST_NAMES=
